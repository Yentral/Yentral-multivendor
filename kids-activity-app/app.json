{
  "expo": {
    "name": "Speel & Leer",
    "slug": "speel-en-leer",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "speelenleer",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FFF5E6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yentral.speelenleer"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF5E6"
      },
      "package": "com.yentral.speelenleer"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ]
    ]
  }
}
